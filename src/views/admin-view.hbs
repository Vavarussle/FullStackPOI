{{> menu}}

<section class="section">
  <div class="title">
    Admin Dashboard
  </div>

  <div class="columns">
    <div class="column">
      <div class="box">
        <strong>Total Users:</strong> {{userCount}}
      </div>
    </div>
    <div class="column">
      <div class="box">
        <strong>Total Categories:</strong> {{categoryCount}}
      </div>
    </div>
    <div class="column">
      <div class="box">
        <strong>Total Placemarks:</strong> {{placemarkCount}}
      </div>
    </div>
    <div class="column">
      <div class="box">
        <strong>Total Images:</strong> {{imageCount}}
      </div>
    </div>
  </div>

  <div class="box">
    <h2 class="title is-4">Users</h2>
    <table class="table is-fullwidth">
      <thead>
        <tr>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Email</th>
          <th>Admin</th>
          <th class="has-text-right">Delete</th>
        </tr>
      </thead>
      <tbody>
        {{#each users}}
          <tr>
            <td>{{firstName}}</td>
            <td>{{lastName}}</td>
            <td>{{email}}</td>
            <td>{{isAdmin}}</td>
            <td class="has-text-right">
              <a href="/admin/deleteuser/{{_id}}" class="ui icon button">
                <i class="fas fa-trash"></i>
              </a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>