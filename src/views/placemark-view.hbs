{{> menu}}

<section class="section">
  <div class="title">Edit Placemark</div>

  <form class="box" action="/placemark/{{category._id}}/updateplacemark/{{placemark._id}}" method="POST">
    <label>Update Placemark Details:</label>

    <div class="field">
      <label class="label">Name</label>
      <div class="control">
        <input class="input" type="text" name="title" value="{{placemark.title}}">
      </div>
    </div>

    <div class="field">
      <label class="label">Description</label>
      <div class="control">
        <input class="input" type="text" name="description" value="{{placemark.description}}">
      </div>
    </div>

    <div class="field">
      <label class="label">Latitude</label>
      <div class="control">
        <input class="input" type="text" name="latitude" value="{{placemark.latitude}}">
      </div>
    </div>

    <div class="field">
      <label class="label">Longitude</label>
      <div class="control">
        <input class="input" type="text" name="longitude" value="{{placemark.longitude}}">
      </div>
    </div>

    <button class="button is-primary">Update Placemark</button>
  </form>

  <div class="box">
    <div class="title is-5">Placemark Image</div>

    {{#if placemark.img}}
      <div class="mb-4">
        <img src="{{placemark.img}}" style="max-width: 300px;">
      </div>
    {{/if}}

    <form action="/placemark/{{placemark._id}}/uploadimage" method="POST" enctype="multipart/form-data">
      <div id="file-select" class="file has-name is-fullwidth">
        <label class="file-label">
          <input class="file-input" name="imagefile" type="file" accept="image/png, image/jpeg">
          <span class="file-cta">
            <span class="file-icon">
              <i class="fas fa-upload"></i>
            </span>
            <span class="file-label">
              Choose a file…
            </span>
          </span>
          <span class="file-name"></span>
        </label>
      </div>
      <div class="mt-3">
        <button type="submit" class="button is-info">Upload Image</button>
      </div>
    </form>
  </div>
</section>

<script>
  const fileInput = document.querySelector(".file-input");
  if (fileInput) {
    fileInput.onchange = () => {
      if (fileInput.files.length > 0) {
        const fileName = document.querySelector(".file-name");
        fileName.textContent = fileInput.files[0].name;
      }
    };
  }
</script>