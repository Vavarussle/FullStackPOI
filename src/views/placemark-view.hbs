{{> menu}}

<section class="section">
  <div class="title">Edit Placemark</div>

  <form class="box" action="/placemark/{{category._id}}/updateplacemark/{{placemark._id}}" method="POST" enctype="multipart/form-data">
    <label>Update Placemark Details:</label>

    <div class="field">
      <label class="label">Name</label>
      <div class="control">
        <input class="input" type="text" name="title" value="{{placemark.title}}">
      </div>
    </div>

    <div class="field">
      <label class="label">Description</label>
      <div class="control">
        <input class="input" type="text" name="description" value="{{placemark.description}}">
      </div>
    </div>

    <div class="field">
      <label class="label">Latitude</label>
      <div class="control">
        <input class="input" type="number" name="latitude" value="{{placemark.latitude}}">
      </div>
    </div>

    <div class="field">
      <label class="label">Longitude</label>
      <div class="control">
        <input class="input" type="number" name="longitude" value="{{placemark.longitude}}">
      </div>
    </div>


    <div class="field has-text-centered">
      <label class="label">Placemark Image</label>

      {{#if placemark.img}}
        <div class="mb-4">
          <img src="{{placemark.img}}" style="max-width: 300px;">
        </div>
      {{/if}}
      <div class="field has-text-centered">
        <div id="file-select" class="file has-name is-centered">
          <label class="file-label">
            <input class="file-input" name="imagefile" type="file" accept="image/png, image/jpeg">
            <span class="file-cta">
              <span class="file-icon">
                <i class="fas fa-upload"></i>
              </span>
              <span class="file-label">
                  {{#if placemark.img}}
                    Change Image…
                  {{else}}
                    Choose an image…
                  {{/if}}
              </span>
            </span>
            <span class="file-name">No image selected</span>
          </label>
        </div>
      </div>
    </div>
    <div class="field has-text-centered">
      <label class="checkbox">
        {{#if placemark.isPublic}}
          <input type="checkbox" name="isPublic" checked>
        {{else}}
          <input type="checkbox" name="isPublic">
        {{/if}}
        Make this placemark public
      </label>
    </div>
    <div class="field has-text-centered">
      <button class="button is-primary">Update Placemark</button>
    </div>
  </form>

  <div class="title is-4 mt-5">Reviews</div>

  <form class="box" action="/placemark/{{category._id}}/addreview/{{placemark._id}}" method="POST">
    <div class="field">
      <label class="label">Add Review</label>
      <div class="control">
        <textarea class="textarea" name="comment" placeholder="Write your review here"></textarea>
      </div>
    </div>
    <div class="field">
      <button class="button is-link">Add Review</button>
    </div>
  </form>

  {{#if reviews.length}}
    {{#each reviews}}
      <div class="box">
        <p><strong>{{reviewerName}}</strong></p>
        <p>{{comment}}</p>

        {{#if canDelete}}
          <a class="button is-small is-danger mt-3" href="/placemark/{{../category._id}}/deletereview/{{../placemark._id}}/{{_id}}">
            Delete Review
          </a>
        {{/if}}
      </div>
    {{/each}}
  {{else}}
    <div class="box">
      <p>No reviews yet.</p>
    </div>
  {{/if}}

</section>

<script>
  const fileInput = document.querySelector(".file-input");
  const fileName = document.querySelector(".file-name");
  if (fileInput && fileName) {
    fileInput.onchange = () => {
      if (fileInput.files.length > 0) {
        fileName.textContent = fileInput.files[0].name;
      } else {
        fileName.textContent = "No image selected";
      }
    };
  }
</script>