{{#if isLoggedIn}}
  {{> menu}}
{{else}}
  {{> welcome-menu}}
{{/if}}

<section class="section">
  <div class="title">Public Categories</div>

  {{#if categories.length}}
    <div class="columns is-multiline">
      {{#each categories}}
        <div class="column is-one-third has-text-centered">
          <div class="box">
            <div class="title is-4">{{title}}</div>
            <p>Public placemarks: {{placemarks.length}}</p>
            <a class="button is-link mt-3" href="/public/category/{{_id}}">View Category</a>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="box">
      <p>No public categories available yet.</p>
    </div>
  {{/if}}
</section>